{
  "version": 1,
  "parser_cases": [
    {
      "name": "sections-comments-and-order",
      "config": "F1 Outside,IGNORE\n# comment\n\n# RUN Messages\nF1 Cq,CQ TEST\n# ordinary comment\nF5 His Call,{CALL}\n# S&P Messages\nF1 Qrl?,QRL?\n# RUN Messages\nF2 Exch,{EXCH}\n",
      "entries": [
        {
          "mode": "run",
          "key": "F1",
          "label": "Cq",
          "target": "CQ TEST"
        },
        {
          "mode": "run",
          "key": "F5",
          "label": "His Call",
          "target": "{CALL}"
        },
        {
          "mode": "s&p",
          "key": "F1",
          "label": "Qrl?",
          "target": "QRL?"
        },
        {
          "mode": "run",
          "key": "F2",
          "label": "Exch",
          "target": "{EXCH}"
        }
      ]
    },
    {
      "name": "padded-case-and-full-labels",
      "config": "  # run messages \n  f5\t His  Call \t,  {CALL}  \nF6\tRepeat\tExchange,CQ, TEST, AGAIN\n# sp messages\nf12 Clear,{ action : Clear }",
      "entries": [
        {
          "mode": "run",
          "key": "F5",
          "label": "His  Call",
          "target": "{CALL}"
        },
        {
          "mode": "run",
          "key": "F6",
          "label": "Repeat\tExchange",
          "target": "CQ, TEST, AGAIN"
        },
        {
          "mode": "s&p",
          "key": "F12",
          "label": "Clear",
          "target": "{ action : Clear }"
        }
      ]
    },
    {
      "name": "empty-labels-and-targets",
      "config": "# RUN Messages\nF1,CQ\nF2   ,  \nF3 - ,\n# S&P Messages\nF4 ,,{CALL},\n",
      "entries": [
        {
          "mode": "run",
          "key": "F1",
          "label": "",
          "target": "CQ"
        },
        {
          "mode": "run",
          "key": "F2",
          "label": "",
          "target": ""
        },
        {
          "mode": "run",
          "key": "F3",
          "label": "-",
          "target": ""
        },
        {
          "mode": "s&p",
          "key": "F4",
          "label": "",
          "target": ",{CALL},"
        }
      ]
    },
    {
      "name": "malformed-lines-and-permissive-keys",
      "config": "# RUN Messages\nmissing comma\n,CQ\n ,CQ\nX1 Wrong,CQ\nF13 Extra,CQ\nFoo Text,TEXT\nF Bare,BARE\nF1 First,ONE\nF1 Second,TWO\n",
      "entries": [
