          "mode": "run",
          "key": "F",
          "label": "Bare",
          "target": "BARE"
        },
        {
          "mode": "run",
          "key": "F1",
          "label": "First",
          "target": "ONE"
        },
        {
          "mode": "run",
          "key": "F1",
          "label": "Second",
          "target": "TWO"
        }
      ]
